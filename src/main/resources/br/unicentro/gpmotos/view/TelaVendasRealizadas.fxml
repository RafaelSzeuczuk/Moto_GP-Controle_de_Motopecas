<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.unicentro.gpmotos.controller.TelaVendasRealizadasController">

    <top>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #f0f0f0; padding: 10;">
            <Label text="Vendas Realizadas">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <TableView fx:id="tabelaVendas" prefHeight="400" prefWidth="700">
                <columns>
                    <TableColumn fx:id="colVendaId" prefWidth="50" text="ID" />
                    <TableColumn fx:id="colCliente" prefWidth="234.54626083374023" text="Cliente" />
                    <TableColumn fx:id="colDataVenda" prefWidth="241.819091796875" text="Data da Venda" />
                    <TableColumn fx:id="colValorTotal" prefWidth="232.7281494140625" text="Valor Total" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #f0f0f0; padding: 10;">
            <Button fx:id="btnExportarPlanilha" onAction="#handleExportarPlanilha" text="Exportar como Planilha" />
            <Button onAction="#handleVoltar" text="Voltar" />
        </HBox>
    </bottom>

</BorderPane>
